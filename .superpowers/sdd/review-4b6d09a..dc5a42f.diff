-compatibility-enhancements.md new file mode 100644 index 0000000..ac688f3 --- /dev/null +++ b/docs/superpowers/plans/2026-08-09-loki-compatibility-enhancements.md @@ -0,0 +1,1353 @@ +# Loki Compatibility Enhancements Implementation Plan + +> **For agentic workers:** REQUIRED SUB-SKILL: Use superpowers:subagent-driven-development (recommended) or superpowers:executing-plans to implement this plan task-by-task. Steps use checkbox (`- [ ]`) syntax for tracking. + +**Goal:** Add structured metadata support, label limit safeguard, and gzip compression to make the sink fully compatible with modern Grafana Loki 3.0+ features while maintaining backward compatibility. + +**Architecture:** Three independent enhancements layered on the existing sink pipeline: (1) `LogEventEntry` gains a `Metadata` dictionary; `LogsStream` and `BatchFormatter` serialize metadata as the optional 3rd element in Loki's values arrays. (2) `GrafanaLokiHttpSink.Emit()` routes properties to labels or metadata based on configuration, and enforces a max label count. (3) `GrafanaLokiHttpClient.PostAsync()` optionally gzip-compresses the JSON payload. All features are opt-in with backward-compatible defaults. + +**Tech Stack:** .NET 10 / .NET Standard 2.0/2.1, Serilog 4.4.0, System.Text.Json, System.IO.Compression.GzipStream + +## Global Constraints + +- **Target frameworks**: `netstandard2.0;netstandard2.1;net10.0` ΓÇö all code must compile on all three +- **Serilog version**: 4.4.0 (already latest) +- **Backward compatibility**: All new features default to `false`/`null` ΓÇö existing behavior unchanged +- **No new NuGet dependencies**: `System.IO.Compression` is available in all target frameworks +- **Test command**: `dotnet test --verbosity quiet` from repo root +- **Build command**: `dotnet build` from repo root + +--- + +### Task 1: Add Metadata Dictionary to LogEventEntry + +**Files:** +- Modify: `src/LogEventEntry.cs` +- Test: `tests/LogEventEntryTests.cs` + +**Interfaces:** +- Produces: `LogEventEntry.Metadata` ΓÇö `Dictionary<string, string>` property, initialized to empty dictionary, included in `GetByteSize()` calculation + +- [ ] **Step 1: Write failing tests for Metadata property and GetByteSize** + +Add to `tests/LogEventEntryTests.cs`: + +```csharp +[Fact] +public void Metadata_IsInitializedEmpty() +{ +    var entry = new LogEventEntry("Test message"); + +    Assert.NotNull(entry.Metadata); +    Assert.Empty(entry.Metadata); +} + +[Fact] +public void GetByteSize_IncludesMetadata_WhenMetadataAdded() +{ +    var entry = new LogEventEntry("Test message"); + +    var sizeBefore = entry.GetByteSize(); +    entry.Metadata.Add("trace_id", "abc123"); +    var sizeAfter = entry.GetByteSize(); + +    Assert.True(sizeAfter > sizeBefore, "Size should increase when metadata is added"); +} + +[Fact] +public void GetByteSize_ReturnsCorrectValue_WithMetadata() +{ +    var entry = new LogEventEntry("Test message"); +    entry.Metadata.Add("trace_id", "abc123"); + +    var size = entry.GetByteSize(); + +    var expectedSize = sizeof(long) +        + ByteSize.From("Test message") +        + ByteSize.From("trace_id") + ByteSize.From("abc123"); +    Assert.Equal(expectedSize, size); +} +``` + +- [ ] **Step 2: Run tests to verify they fail** + +Run: `dotnet test --filter "FullyQualifiedName~Metadata" --verbosity quiet` +Expected: FAIL ΓÇö `Metadata` property does not exist + +- [ ] **Step 3: Add Metadata property and update GetByteSize** + +Modify `src/LogEventEntry.cs`: + +```csharp +using System; +using System.Collections.Generic; +using System.Linq; +using Serilog.Sinks.GrafanaLoki.Common; + +namespace Serilog.Sinks.GrafanaLoki; + +public struct LogEventEntry +{ +    private long _size = -1; +    private int _labelsCount = -1; +    private int _metadataCount = -1; + +    public long Timestamp { get; } +    public string Message { get; } +    public Dictionary<string, string> Labels { get; } = new(); +    public Dictionary<string, string> Metadata { get; } = new(); + +    public LogEventEntry(string message, DateTimeOffset? timestamp = null) +    { +        Message = message; +        Timestamp = UnixTimestamp.GetUnixNanoSeconds(timestamp ?? DateTimeOffset.Now); +    } + +    public long GetByteSize() +    { +        if (Labels.Count == _labelsCount && Metadata.Count == _metadataCount) +        { +            return _size; +        } + +        _labelsCount = Labels.Count; +        _metadataCount = Metadata.Count; +        _size = sizeof(long) +            + ByteSize.From(Message) +            + Labels.Sum(item => ByteSize.From(item.Key) + ByteSize.From(item.Value)) +            + Metadata.Sum(item => ByteSize.From(item.Key) + ByteSize.From(item.Value)); +        return _size; +    } +} +``` + +- [ ] **Step 4: Run all tests to verify they pass** + +Run: `dotnet test --verbosity quiet` +Expected: PASS ΓÇö all 137 tests (134 existing + 3 new) + +- [ ] **Step 5: Commit** + +```bash +git add src/LogEventEntry.cs tests/LogEventEntryTests.cs +git commit -m "feat: add Metadata dictionary to LogEventEntry for structured metadata support" +``` + +--- + +### Task 2: Create StreamEntry and Update LogsStream for Metadata Serialization + +**Files:** +- Create: `src/Internal/StreamEntry.cs` +- Modify: `src/Internal/LogsStream.cs` +- Test: `tests/InternalTests/StreamEntryTests.cs` (new) + +**Interfaces:** +- Consumes: `LogEventEntry.Metadata` from Task 1 +- Produces: `StreamEntry` class with `Timestamp` (string), `Message` (string), `Metadata` (Dictionary<string,string>?) properties; `LogsStream.Entries` changed from `Dictionary<string, string>` to `List<StreamEntry>`; `LogsStream.Values` returns `List<List<object>>` with optional 3rd metadata element + +- [ ] **Step 1: Create StreamEntry class** + +Create `src/Internal/StreamEntry.cs`: + +```csharp +namespace Serilog.Sinks.GrafanaLoki.Internal; + +internal class StreamEntry +{ +    public string Timestamp { get; } +    public string Message { get; } +    public Dictionary<string, string>? Metadata { get; } + +    public StreamEntry(string timestamp, string message, Dictionary<string, string>? metadata = null) +    { +        Timestamp = timestamp; +        Message = message; +        Metadata = metadata; +    } +} +``` + +- [ ] **Step 2: Write StreamEntry tests** + +Create `tests/InternalTests/StreamEntryTests.cs`: + +```csharp +using Serilog.Sinks.GrafanaLoki.Internal; +using Xunit; + +namespace Serilog.Sinks.GrafanaLoki.Tests.InternalTests; + +public class StreamEntryTests +{ +    [Fact] +    public void Constructor_StoresTimestampAndMessage() +    { +        var entry = new StreamEntry("1234567890", "test message"); + +        Assert.Equal("1234567890", entry.Timestamp); +        Assert.Equal("test message", entry.Message); +        Assert.Null(entry.Metadata); +    } + +    [Fact] +    public void Constructor_StoresMetadata_WhenProvided() +    { +        var metadata = new Dictionary<string, string> { { "trace_id", "abc123" } }; + +        var entry = new StreamEntry("1234567890", "test message", metadata); + +        Assert.Same(metadata, entry.Metadata); +    } +} +``` + +- [ ] **Step 3: Run StreamEntry tests to verify they pass** + +Run: `dotnet test --filter "FullyQualifiedName~StreamEntry" --verbosity quiet` +Expected: PASS + +- [ ] **Step 4: Update LogsStream to use List<StreamEntry>** + +Modify `src/Internal/LogsStream.cs`: + +```csharp +using System.Collections.Generic; +using System.Linq; +using System.Text.Json.Serialization; + +namespace Serilog.Sinks.GrafanaLoki.Internal; + +internal class LogsStream +{ +    [JsonPropertyName("stream")] +    public Dictionary<string, string> Labels { get; } = new(); + +    [JsonIgnore] +    public List<StreamEntry> Entries { get; } = new(); + +    [JsonPropertyName("values")] +    public List<List<object>> Values +        => Entries.Select(e => +        { +            var list = new List<object> { e.Timestamp, e.Message }; +            if (e.Metadata != null && e.Metadata.Count > 0) +            { +       